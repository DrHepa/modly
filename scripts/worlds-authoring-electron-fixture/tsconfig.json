{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "jsx": "react-jsx",
    "strict": true, "allowImportingTsExtensions": true, "noEmit": true,
    "esModuleInterop": true, "skipLibCheck": true, "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["../../src/*"],
      "@areas/*": ["../../src/areas/*"],
      "@shared/*": ["../../src/shared/*"],
      "@styles/*": ["../../src/styles/*"]
    }
  },
  "include": ["./*.ts", "./*.tsx", "../../src/vite-env.d.ts", "../../src/shared/types/electron.d.ts", "../../src/shared/types/gaussian-splats-3d.d.ts"]
}
